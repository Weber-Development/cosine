{
  "name": "@sweberdev/cosine",
  "version": "0.2.0",
  "description": "Semantic search for documentation sites that runs entirely in the browser. Build the index once, search with keywords instantly and by meaning once the model has loaded. No server, no API key.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/cosine/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/cosine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/cosine/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js",
    "./dist/element-define.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cosine": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element-define.d.ts",
        "default": "./dist/element-define.js"
      },
      "require": {
        "types": "./dist/element-define.d.cts",
        "default": "./dist/element-define.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "search",
    "semantic-search",
    "documentation",
    "docs-search",
    "embeddings",
    "cosine-similarity",
    "transformers.js",
    "client-side",
    "static-site",
    "web-component"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
